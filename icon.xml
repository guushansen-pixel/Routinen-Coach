<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-Icon fuer den Routinen-Coach: eine Figur mit gestreckten Armen
     und einer Hantel ueber dem Kopf. 108x108, Motiv innerhalb von Radius 31
     um die Mitte (54,54), damit die runde Launcher-Maske nichts abschneidet.
     Hintergrundfarbe kommt per -IconBackground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hantel -->
    <path android:fillColor="#E8EDF2" android:pathData="M34,31 h40 v3 h-40 z" />
    <path android:fillColor="#3FB6A8" android:pathData="M30,26 h5 v13 h-5 z M73,26 h5 v13 h-5 z" />

    <!-- Arme -->
    <path android:fillColor="#E8EDF2" android:pathData="M40,34 l4,-1 l8,18 l-4,2 z M68,34 l-4,-1 l-8,18 l4,2 z" />

    <!-- Kopf -->
    <path android:fillColor="#3FB6A8" android:pathData="M54,40 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Rumpf und Beine -->
    <path android:fillColor="#E8EDF2" android:pathData="M48,50 h12 v16 h-12 z" />
    <path android:fillColor="#E8EDF2" android:pathData="M48,66 h5 l-3,16 h-6 z M55,66 h5 l4,16 h-6 z" />
</vector>
